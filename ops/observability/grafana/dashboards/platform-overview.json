{
  "title": "MorrusPOS Platform Overview",
  "uid": "morruspos-platform",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "API Instances",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum(morrus_api_info)", "refId": "A" }],
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 0 }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Database Ready",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "min(morrus_readiness)", "refId": "A" }],
      "gridPos": { "h": 8, "w": 6, "x": 6, "y": 0 }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Checkout Outcomes",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum by (outcome) (rate(morrus_checkout_attempts_total[5m]))", "legendFormat": "{{outcome}}", "refId": "A" }],
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "HTTP p95 Latency",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_request_duration_seconds_bucket[5m])))", "refId": "A" }],
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 }
    },
    {
      "id": 5,
      "type": "logs",
      "title": "Recent Errors",
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [{ "expr": "{service_name=\"morruspos-api\"} | json | level=\"Error\"", "refId": "A" }],
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 }
    }
  ]
}
