# Simpan sebagai /etc/morrus-pos/backup.env, owner root:morrusdigital, mode 0640.
MORRUS_PROJECT_DIR=/home/morrusdigital/pos-backend
RESTIC_REPOSITORY=s3:https://s3.example.com/morrus-pos-backups/production
RESTIC_PASSWORD_FILE=/etc/morrus-pos/restic-password
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-1

# Harus sama dengan docker-compose.yml production.
POSTGRES_DATA_VOLUME_NAME=morrus-pos_pgdata
UPLOADS_VOLUME_NAME=morrus-pos_uploads

BACKUP_STAGING_DIR=/var/lib/morrus-pos/backup-staging
BACKUP_METRICS_DIR=/var/lib/morrus-pos/backup-metrics
RESTIC_CACHE_DIR=/var/cache/morrus-pos/restic
BACKUP_LOCK_FILE=/var/lock/morrus-pos/backup.lock
BACKUP_SHARED_GROUP=morrusdigital

# Image harus dipin dan dinaikkan melalui pull request teruji.
RESTIC_IMAGE=restic/restic:0.18.1
POSTGRES_IMAGE=postgres:15-alpine
ALPINE_IMAGE=alpine:3.20

BACKUP_HOST_ID=morrus-pos-production
BACKUP_MAX_AGE_HOURS=8
PG_DUMP_COMPRESSION=6
RESTIC_CHECK_SUBSET=5%

# Password database production tidak disimpan di file backup ini. Saat recovery
# permanen, export MORRUS_APP_PASSWORD, MORRUS_SYSTEM_PASSWORD, dan
# MORRUS_MIGRATION_PASSWORD secara sementara dari password vault.

# Hanya untuk CI/local repository. Jangan isi pada konfigurasi S3 production.
# RESTIC_REPOSITORY=/repository
# RESTIC_REPOSITORY_MOUNT=/absolute/host/path/to/repository
