[Unit]
Description=MorrusPOS encrypted offsite backup
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
User=root
Group=morrusdigital
WorkingDirectory=/home/morrusdigital/pos-backend
Environment=BACKUP_ENV_FILE=/etc/morrus-pos/backup.env
ExecStart=/home/morrusdigital/pos-backend/scripts/backup/create-backup.sh scheduled
UMask=0077
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=3h
