[Unit]
Description=MorrusPOS isolated restore drill
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
User=root
Group=morrusdigital
WorkingDirectory=/home/morrusdigital/pos-backend
Environment=BACKUP_ENV_FILE=/etc/morrus-pos/backup.env
ExecStart=/home/morrusdigital/pos-backend/scripts/backup/restore-drill.sh latest
UMask=0077
Nice=15
IOSchedulingClass=idle
TimeoutStartSec=6h
