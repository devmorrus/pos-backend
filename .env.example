# Opsi B GoBiz multi-tenant: appsettings hanya fallback.
# Cara utama isi kredensial: UI Integrasi GoBiz -> Kredensial per Client (tersimpan di gobiz_client_configs).
# Env var di bawah hanya dipakai kalau DB belum ada config untuk Business tersebut.
# Format ASP.NET: GoBiz__Xxx memetakan ke GoBiz:Xxx di appsettings.

MORRUS_APP_PASSWORD=
MORRUS_SYSTEM_PASSWORD=
MORRUS_MIGRATION_PASSWORD=
JWT_SECRET=

# Nama volume eksplisit memudahkan cutover ke hasil restore tanpa menghapus volume lama.
POSTGRES_DATA_VOLUME_NAME=morrus-pos_pgdata
UPLOADS_VOLUME_NAME=morrus-pos_uploads
BACKUP_METRICS_PATH=/var/lib/morrus-pos/backup-metrics

GoBiz__Environment=Sandbox
GoBiz__ClientId=
GoBiz__ClientSecret=
GoBiz__PartnerId=
GoBiz__AuthorizationUrl=https://integration-goauth.gojekapi.com/oauth2/auth
GoBiz__TokenUrl=https://integration-goauth.gojekapi.com/oauth2/token
GoBiz__ApiBaseUrl=https://api.partner-sandbox.gobiz.co.id
GoBiz__RedirectUri=https://localhost:7100/api/gobiz/callback
GoBiz__Scope=gofood:catalog:write gofood:catalog:read gofood:order:write gofood:order:read gofood:outlet:write promo:food_promo:read promo:food_promo:write
GoBiz__WebhookSecret=

# Production contoh (uncomment saat onboarding client production):
# GoBiz__Environment=Production
# GoBiz__ApiBaseUrl=https://api.gobiz.co.id

# Observability production
OBSERVABILITY_ENABLED=true
OTEL_TRACE_SAMPLE_RATIO=1
SERVICE_VERSION=local
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
GRAFANA_ROOT_URL=http://localhost:3000
# File satu baris berisi URL webhook Alertmanager; file ini tidak boleh di-commit.
ALERT_WEBHOOK_FILE=./ops/observability/secrets/alert_webhook_url
QUEUE_MONITORING_ENABLED=true
# Aktifkan setelah lifecycle consumer GoBiz dan baseline backlog diverifikasi.
QUEUE_EVALUATE_BACKLOG=false
QUEUE_POLL_INTERVAL_SECONDS=30
OUTBOX_ENABLED=true
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=50
OUTBOX_MAX_ATTEMPTS=8
OUTBOX_BASE_RETRY_SECONDS=5
OUTBOX_MAX_RETRY_SECONDS=900
OUTBOX_HANDLER_TIMEOUT_SECONDS=30
OUTBOX_LEASE_SECONDS=120
OUTBOX_PROCESSED_RETENTION_DAYS=14
OUTBOX_MAX_PAYLOAD_BYTES=262144
OUTBOX_EVALUATE_BACKLOG=true
