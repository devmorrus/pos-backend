{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "MorrusPOS",
    "Audience": "MorrusPOS.Client",
    "AccessTokenMinutes": "60"
  },
  "Frontend": {
    "Url": "http://localhost:5173"
  },
  "Observability": {
    "Enabled": false,
    "ServiceName": "morruspos-api",
    "OtlpEndpoint": "http://otel-collector:4317",
    "TraceSampleRatio": 1.0
  },
  "QueueMonitoring": {
    "Enabled": true,
    "EvaluateBacklog": false,
    "PollIntervalSeconds": 30,
    "StaleAfterSeconds": 90,
    "WarningDepth": 50,
    "CriticalDepth": 500,
    "WarningOldestAgeSeconds": 120,
    "CriticalOldestAgeSeconds": 600,
    "Queues": {
      "gobiz_order_inbox": {
        "EvaluateBacklog": false
      },
      "outbox": {
        "EvaluateBacklog": true,
        "WarningDepth": 100,
        "CriticalDepth": 1000,
        "WarningOldestAgeSeconds": 60,
        "CriticalOldestAgeSeconds": 300,
        "WarningFailedCount": 1,
        "CriticalFailedCount": 50,
        "CriticalDeadLetterCount": 1
      }
    }
  },
  "Outbox": {
    "Enabled": true,
    "PollIntervalMilliseconds": 1000,
    "BatchSize": 50,
    "MaxAttempts": 8,
    "BaseRetrySeconds": 5,
    "MaxRetrySeconds": 900,
    "HandlerTimeoutSeconds": 30,
    "LeaseSeconds": 120,
    "ProcessedRetentionDays": 14,
    "MaxPayloadBytes": 262144
  },
  "GoBiz": {
    "Environment": "Sandbox",
    "ClientId": "",
    "ClientSecret": "__SET_VIA_ENV_GoBiz__ClientSecret_OR_UI__",
    "PartnerId": "",
    "RedirectUri": "https://localhost:7100/api/gobiz/callback",
    "AuthorizationUrl": "https://integration-goauth.gojekapi.com/oauth2/auth",
    "TokenUrl": "https://integration-goauth.gojekapi.com/oauth2/token",
    "ApiBaseUrl": "https://api.partner-sandbox.gobiz.co.id",
    "Scope": "gofood:catalog:write gofood:catalog:read gofood:order:write gofood:order:read gofood:outlet:write promo:food_promo:read promo:food_promo:write",
    "UserType": "merchant",
    "Prompt": "login",
    "DirectOutletId": "",
    "WebhookSecret": "",
    "TokenRefreshSkewSeconds": 300,
    "RequestTimeoutSeconds": 30
  }
}
